ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
EIA_API_KEY=
SERPER_API_KEY=
APIFY_TOKEN=

ANTHROPIC_MODEL=claude-sonnet-5-5
DAILY_COST_BUDGET_USD=10

# Optional scheduler settings (defaults shown). Leave values unquoted: Docker's env_file keeps quotes literally.
# DESK_TIMEZONE=Asia/Dubai
# COLLECTION_INTERVAL_MINUTES=20
# BRIEF_HOUR=5
# BRIEF_MINUTE=30
# DATA_DIR=            # where the database and vector store live; Docker sets this to /data

# Optional: only for organization-scoped API keys (prefer a workspace-scoped key)
# ANTHROPIC_WORKSPACE_ID=

# Optional: alerts fall back to console/log only if not set
SLACK_WEBHOOK_URL=

# Optional price overrides (defaults live in pricing.py; verify against vendor pricing pages)
# SONNET_INPUT_USD_PER_MTOK=2.00
# SONNET_OUTPUT_USD_PER_MTOK=10.00
# ANTHROPIC_PRICE_MULTIPLIER=1.0
# SERPER_USD_PER_CREDIT=0.001
# APIFY_FALLBACK_USD_PER_RESULT=0.0005
# APIFY_FALLBACK_USD_PER_START=0

# Market prices (Phase 1). The poller needs at least one of: a Twelve Data key, the Yahoo fallback, or EIA_API_KEY.
TWELVE_DATA_API_KEY=
# Unofficial Yahoo Finance endpoint (no key, no published terms or limits). Review Yahoo's terms before relying on it.
ENABLE_YAHOO_FALLBACK=false
# PRICE_PROVIDERS=twelvedata,yahoo,eia     # order tried
# PRICE_POLL_INTERVAL_MIN=5                # inside an instrument's trading window; lengthened automatically to fit quotas
# PRICE_POLL_OFFHOURS_INTERVAL_MIN=60
# PRICE_TICK_RETENTION_DAYS=30
# PRICE_STALE_MINUTES=30
# Provider limits (credits). Twelve Data defaults are its published Basic plan; Yahoo and EIA values are conservative guesses.
# TWELVE_DATA_MAX_PER_MIN=8
# TWELVE_DATA_MAX_PER_DAY=800
# YAHOO_MAX_PER_MIN=20
# YAHOO_MAX_PER_DAY=2000
# EIA_MAX_PER_MIN=10
# EIA_MAX_PER_DAY=500

# Brief catch-up: from this desk-time the scheduler writes a missed brief. Default is 30 minutes after BRIEF_HOUR:BRIEF_MINUTE.
# CATCHUP_AFTER_HOUR=6
# CATCHUP_AFTER_MINUTE=0

# Market context (Phase 2)
# EIA_WEEKLY_REFRESH_HOURS=6               # weekly stocks and gas storage are refetched at most this often
# Dashboard header thresholds, in minutes (defaults shown are derived from the intervals above)
# STALE_COLLECTION_AMBER_MIN=40
# STALE_COLLECTION_RED_MIN=80
# STALE_PRICE_AMBER_MIN=15
# STALE_PRICE_RED_MIN=60
# STALE_BRIEF_RED_AFTER_MIN=180            # brief missing this long after the catch-up time turns red

# Trust and quality (Phase 3)
# CLUSTER_SIMILARITY_THRESHOLD=0.45        # headline similarity at which articles join one story
# CORROBORATION_MIN_SIMILARITY=0.40        # title similarity a Serper result needs to count as corroboration
# BACKTEST_MIN_OBSERVATIONS=30             # paired days needed before the Research page shows statistics
