# Secrets and local data must never be baked into an image.
# Patterns are relative to the build context root, so a bare *.db would match only top-level files: use **/ for any depth.
.env
**/*.db
**/*.db-wal
**/*.db-shm
# The one database that belongs in the image: the reviewed demo snapshot (DEMO_MODE). The last matching line wins.
!demo/demo_store.db
oil_gas_archive/
eval_history.jsonl

# Local environment and caches
venv/
__pycache__/
*.pyc

# Not needed at runtime
.git/
.github/
.claude/
CLAUDE.md
USER_GUIDE.md
README.md
docs/
Dockerfile
docker-compose.yml
.dockerignore
reports/
tests/
.pytest_cache/
pytest.ini
requirements-dev.txt
CLAUDE_CODE_TASKS.md
CLAUDE_CODE_PROMPT_DEMO_DOCKER.md
outbox/
